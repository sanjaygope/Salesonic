{
  "version": 2,
  "builds": [
    {
      "src": "web/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" },
      "buildCommand": "npm --prefix frontend run build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "web/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}