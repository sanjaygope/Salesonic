{
  "version": 2,
  "projects": [
    {
      "name": "salesman-ai-frontend",
      "root": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": "build"
    },
    {
      "name": "salesman-ai-backend",
      "root": "web",
      "buildCommand": "npm install",
      "outputDirectory": "."
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "salesman-ai-backend"
    },
    {
      "src": "/(.*)",
      "dest": "salesman-ai-frontend"
    }
  ]
}